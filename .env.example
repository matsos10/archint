# ---------------------------------------------------------------------------
# Somar — variáveis de ambiente. Copia para .env e preenche. NUNCA commits o .env.
# ---------------------------------------------------------------------------

# URL pública da app (usada em links de email e no QR de 2FA)
APP_URL=https://app.exemplo.pt

# Neon: ligação com pooling (PgBouncer) para a app e o worker…
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/somar?sslmode=require&channel_binding=require
# …e ligação direta (sem "-pooler") para as migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/somar?sslmode=require&channel_binding=require

# Chaves AES-256-GCM (32 bytes em base64) para campos sensíveis e ficheiros.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotação: acrescenta "2=<nova>" — a versão mais alta encripta, as anteriores continuam a desencriptar.
ENCRYPTION_KEYS=1=COLOCA_AQUI_A_CHAVE_BASE64

# Diretório dos ficheiros encriptados (volume Docker "files")
STORAGE_DIR=/data/files

# Nome da rede Docker partilhada com o Nginx Proxy Manager
PROXY_NETWORK=npm_proxy

# Etiqueta das imagens (opcional)
TAG=latest

# Open banking (PSD2, só leitura) — GoCardless Bank Account Data. Sem credenciais, a ligação
# automática a bancos fica indisponível (em desenvolvimento usa-se um banco simulado).
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# BANK_PROVIDER=mock   # força o agregador simulado (nunca em produção)

# Faturação certificada (InvoiceXpress). Sem estas variáveis usa-se o fornecedor de demonstração,
# cujos documentos NÃO têm validade fiscal; em produção a emissão fica bloqueada (salvo INVOICING_SANDBOX=1).
INVOICEXPRESS_ACCOUNT=
INVOICEXPRESS_API_KEY=
INVOICEXPRESS_CERTIFICATE=
# INVOICING_SANDBOX=1

# Email (faturas, orçamentos, lembretes). Sem SMTP_URL, os emails só são registados no log.
SMTP_URL=smtps://utilizador:palavra-passe@smtp.exemplo.pt:465
MAIL_FROM="Somar <nao-responder@exemplo.pt>"
