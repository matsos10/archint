{
  "name": "somar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @somar/web dev",
    "dev:worker": "pnpm --filter @somar/worker dev",
    "build": "pnpm -r --filter ./apps/** build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @somar/db generate",
    "db:migrate": "pnpm --filter @somar/db migrate",
    "db:seed": "pnpm --filter @somar/db seed"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "fast-xml-parser": "^5.11.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
